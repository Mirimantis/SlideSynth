# Where `npm run deploy` publishes a test build (BACKLOG 13.28).
# Copy this file to deploy.env.local (ignored by git) and fill it in.
DEPLOY_HOST=example.com
DEPLOY_PORT=21098
DEPLOY_USER=cpaneluser
# The subdomain's document root. Everything in it is replaced on each deploy,
# except .well-known (the certificate renewal's folder).
DEPLOY_PATH=/home/cpaneluser/sub.example.com
# The private key on this computer (~ is your home folder).
DEPLOY_KEY=~/.ssh/gliss_deploy
